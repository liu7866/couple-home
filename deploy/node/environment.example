# Local development defaults. Keep this file private after copying to .env.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
TRUST_PROXY=0
# Production: use absolute persistent paths outside the release directory.
# DATA_DIR=/var/lib/little-days
# BACKUP_DIR=/var/backups/little-days
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
# Optional private first-run code for HTTPS web setup (24-128 characters).
# If omitted, the server creates a private code and prints it in its startup log.
# SETUP_CODE=replace-with-your-private-initialization-code

# Optional AI album. Disabled until all four settings are provided.
# Use a base URL such as https://YOUR_PROVIDER/v1 (no endpoint suffix).
# ALBUM_AI_BASE_URL=https://YOUR_PROVIDER/v1
# ALBUM_AI_API_KEY=your-private-provider-key
# ALBUM_AI_VISION_MODEL=your-image-input-model
# ALBUM_AI_EMBEDDING_MODEL=your-text-embedding-model
