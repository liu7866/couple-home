[Unit]
Description=Our Little Days verified snapshot
After=little-days.service

[Service]
Type=oneshot
User=little-days
Group=little-days
WorkingDirectory=/opt/little-days/current
EnvironmentFile=/etc/little-days.env
ExecStart=/usr/bin/node /opt/little-days/current/backup.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/little-days /var/backups/little-days
