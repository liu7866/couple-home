# Copy to .dev.vars for LOCAL development only. Configure production secrets in Sites.
OWNER_LOGIN_EMAIL=owner@example.test
# Optional static frontend origin, without path/trailing slash
PAGES_ORIGIN=https://pages.example.test

# Standalone Node.js server defaults (copy to .env when needed)
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
# Use absolute persistent DATA_DIR / BACKUP_DIR paths in production.

# Optional AI album. Disabled until all four settings are provided.
# Use a base URL such as https://YOUR_PROVIDER/v1 (no endpoint suffix).
# ALBUM_AI_BASE_URL=https://YOUR_PROVIDER/v1
# ALBUM_AI_API_KEY=your-private-provider-key
# ALBUM_AI_VISION_MODEL=your-image-input-model
# ALBUM_AI_EMBEDDING_MODEL=your-text-embedding-model
